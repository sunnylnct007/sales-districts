        <mxCell id="c16" value="       Role           NVARCHAR(20)  CHECK ('Secondary')" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="c13"><mxGeometry y="72" width="380" height="22" as="geometry"/></mxCell>
        <mxCell id="c17" value="is primary of (exactly one per district)" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;rounded=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c18" value="contains" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;rounded=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c19" value="has non-primary roles" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;rounded=0;" edge="1" parent="1" source="c5" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c20" value="holds" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;rounded=0;" edge="1" parent="1" source="c2" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;Rules enforced by the database&lt;/b&gt;&lt;br&gt;&amp;bull; Exactly one primary per district: District.PrimarySalespersonId NOT NULL&lt;br&gt;&amp;bull; A salesperson may be primary of several districts: no UNIQUE on PrimarySalespersonId&lt;br&gt;&amp;bull; No duplicate assignment: PK (DistrictId, SalespersonId)&lt;br&gt;&amp;bull; Primary cannot also hold a role in the same district: triggers TR_DistrictSalesperson_NotPrimary and TR_District_PrimaryHasNoOtherRole (UPDLOCK, HOLDLOCK)&lt;br&gt;&amp;bull; Store belongs to exactly one existing district: Store.DistrictId NOT NULL FK&lt;br&gt;&amp;bull; Unique, non-blank names; only known roles: UNIQUE and CHECK constraints&lt;br&gt;&amp;bull; Not enforced on purpose: every salesperson has at least one district" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="810" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
