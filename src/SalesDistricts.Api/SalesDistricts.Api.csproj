<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <ContainerRepository>salesdistricts-api</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.100" />
        <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="3.2.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\database\*.sql" LogicalName="Scripts.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
